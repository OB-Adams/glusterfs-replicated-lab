; Random 4 KiB, 70% reads and 30% writes: a general-purpose mix.
; Run with BENCH_DIR set to the directory under test, e.g. via run-bench.sh.
[global]
directory=${BENCH_DIR}
filename_format=bench.$jobnum.$filenum
ioengine=libaio
direct=1
size=1g
numjobs=4
group_reporting=1
time_based=1
ramp_time=10
runtime=60

[mixed-70-30]
rw=randrw
rwmixread=70
bs=4k
iodepth=16
