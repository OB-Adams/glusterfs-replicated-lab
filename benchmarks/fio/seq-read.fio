; Sequential 1 MiB reads: large-file read throughput.
; Run with BENCH_DIR set to the directory under test, e.g. via run-bench.sh.
[global]
directory=${BENCH_DIR}
filename_format=bench.$jobnum.$filenum
ioengine=libaio
direct=1
size=1g
numjobs=4
group_reporting=1
time_based=1
ramp_time=10
runtime=60

[seq-read]
rw=read
bs=1m
iodepth=16
